{
  "name": "abstractify",
  "version": "1.0.0",
  "description": "De-jargonize research. Find consensus. Map the science.",
  "main": "public/index.html",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "build": "echo 'No build step required for static frontend'",
    "lint": "eslint netlify/functions/**/*.ts",
    "lint:fix": "eslint netlify/functions/**/*.ts --fix",
    "format": "prettier --write \"netlify/functions/**/*.ts\"",
    "format:check": "prettier --check \"netlify/functions/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "sync-wiki": "node scripts/sync-wiki.js"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@netlify/functions": "^2.6.0",
    "@upstash/redis": "^1.38.4",
    "@upstash/vector": "^1.2.3",
    "dotenv": "^16.4.5",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.0.0",
    "netlify-cli": "^27.4.3",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
